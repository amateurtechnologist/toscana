{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "toscana",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-16",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "CATEGORY_A_ID": "",
    "CATEGORY_A_FORWARD_CHANNEL_ID": "",
    "CATEGORY_B_ID": "",
    "CATEGORY_B_FORWARD_CHANNEL_ID": "",
    "TOSCANA_BLACKLIST_CHANNEL_IDS": "",
    "TOSCANA_BLACKLIST_GUILD_IDS": ""
  },
  "secrets": {
    "required": ["DISCORD_TOKEN"]
  },
  "observability": {
    "enabled": true,
    "logs": { "enabled": true },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  },
  "containers": [
    {
      "name": "toscana-container",
      "class_name": "ToscanaContainer",
      "image": "./Dockerfile",
      "instance_type": "lite",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "TOSCANA_CONTAINER",
        "class_name": "ToscanaContainer"
      }
    ]
  },
  "exports": {
    "ToscanaContainer": {
      "type": "durable-object",
      "storage": "sqlite",
      "container": "toscana-container"
    }
  }
}
